FROM --platform=linux/arm64 node:22-bookworm-slim AS web
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY tokens.css /src/tokens.css
COPY frontend/ ./
RUN npm run build

FROM --platform=linux/arm64 python:3.12-slim-bookworm
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libgomp1 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md LICENSE ./
COPY a64forge/ ./a64forge/
RUN pip install --no-cache-dir .
COPY --from=web /src/frontend/dist ./frontend/dist
COPY configs/ ./configs/
COPY examples/ ./examples/
COPY docs/ ./docs/
COPY scripts/ ./scripts/
RUN python -c "import platform; assert platform.machine().lower() in {'aarch64','arm64'}"
EXPOSE 8640
CMD ["a64forge", "serve", "--host", "0.0.0.0", "--port", "8640"]
